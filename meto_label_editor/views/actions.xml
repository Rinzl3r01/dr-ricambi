<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_meto_editor" model="ir.actions.client">
    <field name="name">METO Label Editor</field>
    <field name="tag">meto_label_editor.editor</field>
  </record>
  <menuitem id="menu_meto_root" name="METO" action="action_meto_editor" groups="base.group_user" web_icon="meto_label_editor,static/description/icon.svg" sequence="85"/>
  <record id="action_meto_product_template" model="ir.actions.server">
    <field name="name">Apri in METO</field>
    <field name="model_id" ref="product.model_product_template"/>
    <field name="binding_model_id" ref="product.model_product_template"/>
    <field name="binding_view_types">form</field>
    <field name="state">code</field>
    <field name="code">if record:
    action = {'type': 'ir.actions.client', 'tag': 'meto_label_editor.editor', 'name': 'METO', 'params': {'model': 'product.template', 'record_id': record.id}}</field>
  </record>
  <record id="action_meto_product_variant" model="ir.actions.server">
    <field name="name">Apri in METO</field>
    <field name="model_id" ref="product.model_product_product"/>
    <field name="binding_model_id" ref="product.model_product_product"/>
    <field name="binding_view_types">form</field>
    <field name="state">code</field>
    <field name="code">if record:
    action = {'type': 'ir.actions.client', 'tag': 'meto_label_editor.editor', 'name': 'METO', 'params': {'model': 'product.product', 'record_id': record.id}}</field>
  </record>
</odoo>
