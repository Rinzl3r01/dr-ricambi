      <iframe t-if="state.url" t-ref="editor" t-att-src="state.url" t-on-load="onFrameLoad" title="METO Label Editor" allow="loopback-network https://meto-label-editor.ecommerce-d86.workers.dev; local-network-access https://meto-label-editor.ecommerce-d86.workers.dev" referrerpolicy="no-referrer" style="width:100%;min-height:650px;flex:1;border:0;"/>
