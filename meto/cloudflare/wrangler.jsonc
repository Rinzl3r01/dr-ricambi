{
  "name": "meto-label-editor",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ODOO_ORIGINS": "https://drricambi.it"
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "QZ_LOGIN_LIMITER",
      "namespace_id": "2026102001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "QZ_SIGN_LIMITER",
      "namespace_id": "2026102002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
